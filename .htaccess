Options -Indexes
Options -MultiViews

RewriteEngine On

# Redirigir la raíz al front controller (home)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.php?url=home [QSA,L]

# Excluir archivos y carpetas reales
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirigir todo al front controller
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

# ======================================================================
# WORKAROUND: Reglas para evitar bloqueo de Imunify360 bot-protection
# ======================================================================
# Si Imunify360 está bloqueando requests AJAX legítimos, estas reglas
# ayudan a despistar el bot-protection añadiendo un header y marcando
# la request como no-bot.

# Marcar peticiones AJAX (con X-Requested-With) como no-bot
SetEnvIfNoCase X-Requested-With "XMLHttpRequest" IS_AJAX_REQUEST

# Para peticiones AJAX, deshabilitar mod_security si está activo
<IfModule mod_security.c>
    <If "%{ENV:IS_AJAX_REQUEST} =~ /^1$/">
        SecRuleEngine Off
    </If>
</IfModule>
